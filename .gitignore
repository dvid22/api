# Crea .gitignore con contenido:
cat > .gitignore << EOF
# Secretos
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Archivos de configuración sensibles
*.json
*.key
*.pem
*.p12
*.crt
*.cer

# Firebase
firebase-adminsdk*.json
serviceAccountKey.json

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo

# Sistema
.DS_Store
Thumbs.db
EOF